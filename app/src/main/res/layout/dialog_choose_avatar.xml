<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surfaceColor">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/cardStroke"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choose_avatar"
        android:textColor="@color/textDark"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemoveAvatar"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="12dp"
        android:text="@string/remove_current_avatar"
        android:textAllCaps="false"
        android:textColor="@color/errorText"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_menu_delete"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:strokeColor="@color/errorText"
        app:strokeWidth="1.5dp"
        app:iconTint="@color/errorText"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickGallery"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="24dp"
        android:text="@string/choose_from_gallery"
        android:textAllCaps="false"
        android:textColor="@color/primaryBlue"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_menu_gallery"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:strokeColor="@color/primaryBlue"
        app:strokeWidth="1.5dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/or_use_emoji"
        android:textColor="@color/textSecondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:letterSpacing="0.1"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEmojiGrid"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="4" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseEmoji"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="@string/close"
        android:textColor="@color/textSecondary" />

</LinearLayout>
